rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if user is logged in
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Check if user is an admin
    function isAdmin() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Default deny
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    match /bootcamps/{bootcampId} {
      allow read: if isAuthenticated();

      match /students/{studentId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated() && (request.auth.uid == studentId || isAdmin());
      }

      match /volunteers/{volunteerId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated() && (request.auth.uid == volunteerId || isAdmin());
      }

      match /teams/{teamId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin();
      }

      match /tasks/{taskId} {
        allow read: if isAuthenticated();
        
        match /tutorials/{tutId} {
          allow read: if isAuthenticated();
        }
        match /subtasks/{subId} {
          allow read: if isAuthenticated();
        }
      }

      match /submissions/{submissionId} {
        // Anyone authenticated in the bootcamp can read (e.g. volunteers reading student subs)
        allow read: if isAuthenticated();
        
        // Students can only create their own submissions
        allow create: if isAuthenticated() && request.resource.data.studentId == request.auth.uid;
        
        // Volunteers can update (grade) submissions
        allow update: if isAuthenticated();
      }

      match /leaderboard/{entryId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated(); // Allowed for batch updates from grading
      }
    }
  }
}
